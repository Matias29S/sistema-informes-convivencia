Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Bloquear acceso directo a datos privados
  RewriteRule ^(config|includes|database|storage)(/|$) - [F,L]
</IfModule>

# Fallback si mod_rewrite no está disponible
<FilesMatch "^(colegio\.sql|.*\.log)$">
  Require all denied
</FilesMatch>

# Seguridad básica
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
